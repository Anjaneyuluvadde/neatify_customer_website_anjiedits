/* ================= APP POPUP STYLES ================= */
.popup-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  backdrop-filter: blur(6px);
  padding: 20px;
}

@keyframes popupSlideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* ================= CONSOLIDATED POPUP CONTAINER ================= */
.static-list-container,
.popup-slideshow-container {
  background: white;
  border-radius: 32px;
  max-width: 440px;
  width: 100%;
  position: relative;
  overflow: hidden;
  box-shadow: 0 40px 120px -20px rgba(0, 0, 0, 0.4);
  animation: popupSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* PREMIUM CLOSE BUTTON (SHARED) */
.popup-close-btn-fixed {
  position: absolute;
  top: 15px;
  right: 15px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  color: white;
  z-index: 1000;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.popup-close-btn-fixed:hover {
  transform: rotate(90deg) scale(1.1);
  background: #000;
  color: #fff;
}

.single-slide-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.popup-slide {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.popup-container-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.popup-slide-content {
  padding: 0;
  text-align: center;
  width: 100%;
}

