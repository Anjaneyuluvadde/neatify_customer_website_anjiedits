  max-width: 750px;
  margin: 40px auto;
  padding-top: 48px; /* space above heading */
}

/* ================= SCHEDULER STYLE BACK BUTTON ================= */

.back-arrow {
  position: absolute;
  top: 0;
  left: 0;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 14px;
  font-weight: 500;
  color: #111827;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.back-arrow:hover {
  background: #f9fafb;
}
/* ================= STATUS PILL (RIGHT SIDE) ================= */

.booking-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* COMMON STATUS STYLE */
.status-pill {
  padding: 4px 10px;
  font-size: 12px;
  font-weight: 700;
  border-radius: 999px;
  text-transform: uppercase;
}

/* COMPLETED → GREEN */
.status-completed {
  background-color: #dcfce7; /* light green */
