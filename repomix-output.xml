/* ==================== MODALS ==================== */
/* ✅ Prevent background scrolling when modal is open */
.no-scroll {
  overflow: hidden !important;
  height: 100vh !important;
  width: 100% !important;
  position: fixed !important;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 99999;
  transition: opacity 0.3s ease;
  overscroll-behavior: contain;
  padding: 20px;
  /* Gap around popup from screen edges */
}

@media (max-width: 640px) {
  .modal-overlay {
    align-items: center;
  }
}

.modal-container {
  background: #fff;
  width: 420px;
  max-width: 90%;
  border-radius: 20px;
  padding: 20px 24px 16px;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0;
  max-height: 70vh;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  animation: modalFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
  border: none;
}

.modal-scroll-content {
  overflow-y: auto;
  flex: 1;
  padding: 0 8px 0 0;
  -webkit-overflow-scrolling: touch;
}

/* ========== MODAL HEADER (Add Ons title + inline close) ========== */
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid #f1f1f1;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.modal-heading {
  font-size: 18px;
  font-weight: 800;
  color: #111827;
  margin: 0;
  letter-spacing: -0.3px;
}

.modal-close-inline {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s ease;
}

.modal-close-inline::before {
  content: "✕";
  font-size: 13px;
  font-weight: 900;
  color: #fff;
}

.modal-close-inline:hover {
  background: rgba(0, 0, 0, 0.6);
}

.modal-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 12px 0 16px;
  border-top: 1px solid #f1f1f1;
  background: #fff;
  margin-top: 8px;
}

.modal-continue-btn {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #f4c430 0%, #fcd34d 100%);
  color: #000;
  border: none !important;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 900;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 10px 25px -5px rgba(244, 196, 48, 0.4), 0 8px 10px -6px rgba(244, 196, 48, 0.4);
  letter-spacing: 0.1px;
  position: relative;
  overflow: hidden;
}

.modal-continue-btn::after {
  content: "";
  position: absolute;
  top: -50%;
  left: -60%;
  width: 20%;
  height: 200%;
  background: rgba(255, 255, 255, 0.4);
  transform: rotate(30deg);
  transition: none;
  animation: buttonShine 4s infinite;
}

.modal-continue-btn:hover {
  background: linear-gradient(135deg, #f4c430 0%, #fde047 100%);
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 20px 30px -10px rgba(244, 196, 48, 0.5);
}

.modal-continue-btn:active {
  transform: translateY(-1px) scale(0.98);
}

@media (max-width: 640px) {
  .modal-container {
    width: 90%;
    max-width: 420px;
    border-radius: 24px;
    padding: 24px;
    margin: 0;
    max-height: 85vh;
    animation: modalFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-scroll-content {
    padding: 24px 24px 16px;
  }

  .modal-footer {
    padding: 12px 20px 32px;
  }
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

