  transform: translateY(-50%);
  background: #ffffff;
  border: 1px solid #f1f5f9;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  color: #f4c430 !important;
  /* Signature Saffron */
  z-index: 500;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.popup-nav-btn:hover {
  background: #fffdf5;
  transform: translateY(-50%) scale(1.1);
  border-color: #fef08a;
  box-shadow: 0 10px 25px rgba(244, 196, 48, 0.15);
}

.popup-nav-btn.prev {
  left: 15px;
}

.popup-nav-btn.next {
  right: 15px;
}

.popup-nav-btn svg {
