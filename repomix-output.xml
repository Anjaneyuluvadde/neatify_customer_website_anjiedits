  background: #fef2f2;
}

/* ================= DOWNLOAD MODAL PREMIUM STYLES ================= */

.download-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  animation: fadeIn 0.3s ease-out;
}

.download-modal {
  background: #ffffff;
  padding: 40px 30px;
  border-radius: 28px;
  width: 420px;
  max-width: 90%;
  text-align: center;
  position: relative;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.5);
  animation: modalScaleUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes modalScaleUp {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(20px);
  }

  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.download-close {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: #f3f4f6;
  color: #4b5563;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 18px;
}

.download-close:hover {
  background: #f4c430;
  color: #000;
  transform: rotate(90deg);
}

.download-title {
  font-size: 24px;
  font-weight: 800;
  color: #111827;
  margin-bottom: 12px;
  line-height: 1.2;
}

.download-subtitle {
  font-size: 16px;
  color: #6b7280;
  margin-bottom: 32px;
  line-height: 1.5;
}

.download-options {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.download-btn {
  height: 46px;
  padding: 0 24px;
  border-radius: 23px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  text-decoration: none;
  font-weight: 800;
  font-size: 14px;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
  width: 100%;
  font-family: inherit;
  box-sizing: border-box;
}

.download-btn.google-play {
  background: linear-gradient(135deg, #f4c430 0%, #fde047 100%) !important;
  color: #000;
  box-shadow: 0 4px 12px rgba(244, 196, 48, 0.2);
  position: relative;
  overflow: hidden;
}

.download-btn.google-play::after {
  content: "";
  position: absolute;
  top: -50%;
  left: -60%;
  width: 20%;
  height: 200%;
  background: rgba(255, 255, 255, 0.4);
  transform: rotate(30deg);
  transition: none;
  animation: buttonShine 4s infinite;
}

.download-btn.google-play:hover {
  background: linear-gradient(135deg, #f4c430 100%, #fde047 0%) !important;
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 8px 20px rgba(244, 196, 48, 0.35);
}

.download-btn.google-play img {
  height: 24px;
  margin-right: 12px;
  position: relative;
  z-index: 2;
}

.download-btn.google-play span {
  position: relative;
  z-index: 2;
}

.download-btn.app-store {
  background: #f3f4f6;
  color: #9ca3af;
  cursor: not-allowed;
  border: 1px solid #e5e7eb;
}

.download-btn.app-store img {
  height: 24px;
  filter: grayscale(1);
  opacity: 0.5;
}

.qr-section {
  margin-top: 35px;
  padding-top: 25px;
  border-top: 1px dashed #e5e7eb;
}

.qr-container {
  background: #f9fafb;
  border-radius: 20px;
  padding: 20px;
  display: inline-block;
  border: 1px solid #f1f5f9;
}

.qr-label {
  font-size: 14px;
  font-weight: 700;
  color: #374151;
  margin-bottom: 15px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.qr-box {
  background: #fff;
  padding: 10px;
  border-radius: 12px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.qr-box img {
  width: 130px;
  height: 130px;
  display: block;
}
