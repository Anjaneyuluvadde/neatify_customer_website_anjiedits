/* ================= CONTAINER ================= */

.booking-details-container {
  max-width: 750px;
  margin: 40px auto;
  padding: 20px;
}

/* ================= TITLE ================= */

.booking-details-container h2 {
  font-size: 26px;
  font-weight: 800;
  margin-bottom: 20px;
}

/* ================= DETAILS CARD ================= */

.details-card {
  border: 1px solid #ddd;
  padding: 20px;
  border-radius: 12px;
