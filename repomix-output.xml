}

/* ==================== SCROLL HINT ==================== */
.scroll-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  margin-top: 32px;
  padding-top: 16px;
  border-top: 1px dashed #e5e7eb;
  color: #9ca3af;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  opacity: 0.8;
  animation: scrollPulse 2s infinite;
}

.scroll-arrow {
  font-size: 16px;
  font-weight: 800;
}

@keyframes scrollPulse {

  0%,
  100% {
    transform: translateY(0);
    opacity: 0.6;
  }

  50% {
    transform: translateY(4px);
    opacity: 1;
  }
}

.next-btn:disabled {
  background: #e5e7eb;
  color: #9ca3af;
  cursor: not-allowed;
  box-shadow: none;
}

/* MOBILE STICKY FOOTER (Hidden on desktop) */
.mobile-booking-footer {
  display: none;
}

/* ================== PREMIUM MOBILE RESPONSIVE ================== */
@media (max-width: 900px) {
  .booking-container {
    /* top padding adjusted so heading clears the back button */
    padding: 32px 16px 120px;
  }

  .booking-layout {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .calendar-section h1 {
    font-size: 22px;
  }

  .subtitle {
    font-size: 14px;
    margin-bottom: 20px;
  }

  .scheduler-row {
    flex-direction: column;
    gap: 24px;
  }

  .calendar-tilt-wrapper {
    width: 100%;
    max-width: 100%;
  }

  /* CALENDAR GRID - Multi-column Fix */
  .calendar-grid {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    grid-template-columns: repeat(7, 1fr);
    /* Simplest equal columns */
    grid-auto-rows: auto;
    gap: 4px;
    padding: 16px 8px;
    justify-items: stretch;
    align-items: center;
    /* Center items in their cells */
  }

  .date,
  .empty {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    font-size: 13px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  .day-label {
    width: 100%;
    font-size: 10px;
    height: 36px;
    letter-spacing: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a1a1aa;
    font-weight: 800;
  }

  /* TIME SECTION */
  .time-section {
    min-width: 0;
    width: 100%;
  }

  /* TIME GRID - 3 columns */
  .time-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .time-box {
    padding: 12px 4px;
    font-size: 13px;
  }

  /* SUMMARY SECTION - Minimal on mobile */
  .summary {
    position: static;
    padding: 20px;
    border-radius: 16px;
    box-shadow: none;
  }

  .summary .next-btn {
    display: none;
  }

  /* STICKY FOOTER - Visible on mobile */
  .mobile-booking-footer {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 16px 20px 32px;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.1);
    border-top: 1px solid #f3f4f6;
    z-index: 2000;
  }

  .mobile-footer-info {
    display: flex;
    flex-direction: column;
  }

  .footer-total {
    font-size: 24px;
    font-weight: 900;
    color: #111827;
  }

  .footer-sub {
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
  }

  .mobile-next-btn {
    background: linear-gradient(135deg, #f4c430 0%, #fde047 100%);
    color: #000;
    border: none;
    padding: 16px 36px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 800;
    box-shadow: 0 10px 25px rgba(244, 196, 48, 0.25);
    position: relative;
    overflow: hidden;
  }

  .mobile-next-btn::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -60%;
    width: 20%;
    height: 200%;
    background: rgba(255, 255, 255, 0.4);
    transform: rotate(30deg);
    transition: none;
    animation: buttonShine 4s infinite;
  }

  .mobile-next-btn:disabled {
    background: #e5e7eb;
    color: #9ca3af;
    box-shadow: none;
    opacity: 0.7;
  }
}

/* ==================== PROFESSIONAL LIQUID ANIMATIONS ==================== */
@keyframes liquidFadeInUp {
  0% {
    opacity: 0;
    transform: translateY(30px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes liquidScaleIn {
  0% {
    opacity: 0;
    transform: scale(0.85);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes premiumPop {
  0% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.1);
  }

  100% {
    transform: scale(1);
  }
}

@keyframes premiumSlideInHorizontal {
  0% {
    opacity: 0;
    transform: translateX(20px);
  }

  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes premiumGlowPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(244, 196, 48, 0.5);
  }

  70% {
    box-shadow: 0 0 0 15px rgba(244, 196, 48, 0);
  }

  100% {
    box-shadow: 0 0 0 0 rgba(244, 196, 48, 0);
  }
}

.calendar-section h1 {
  animation: liquidFadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

.subtitle {
  animation: liquidFadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s backwards;
}

.month-year {
  animation: liquidFadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s backwards;
}

.calendar-grid {
  animation: liquidScaleIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s backwards;
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  transform-style: preserve-3d;
  will-change: transform;
}

.date {
  animation: liquidScaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  animation-delay: calc(0.3s + (var(--i, 0) * 0.015s));
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.date:hover:not(:disabled) {
  transform: translateY(-4px) scale(1.08);
}

.date.selected {
  animation: premiumPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 10px 25px rgba(244, 196, 48, 0.4);
}

.time-section {
  animation: premiumSlideInHorizontal 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

.time-box {
  animation: liquidScaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  animation-delay: calc(0.1s + (var(--i, 0) * 0.02s));
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.time-box:hover:not(.disabled-time) {
  transform: translateY(-4px) scale(1.05);
}

.time-box.selected-time {
  animation: premiumPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), premiumGlowPulse 2.5s infinite;
  box-shadow: 0 8px 20px rgba(244, 196, 48, 0.4) !important;
}

.summary {
  animation: liquidFadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
  transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.back-btn-circle {
  animation: liquidScaleIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s backwards;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.back-btn-circle:hover {
  transform: translateY(-50%) scale(1.12) rotate(-8deg);
}

/* ✅ Add-ons Modal Scroll Down Indicator */
.addon-scroll-down {
  position: sticky;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: #ffffff;
  padding: 10px 20px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 800;
  color: #f4c430;
  cursor: pointer;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  z-index: 150;
  animation: bounceModal 2s infinite;
  border: 1.5px solid rgba(244, 196, 48, 0.3);
  margin-top: -50px;
