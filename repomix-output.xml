  top: 24px;
  left: 24px;
  background: none;
  border: none;
  font-size: 15px;
  font-weight: 500;
  color: #000;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.back-btn.top-left:hover {
  text-decoration: underline;
}

/* Ensure container can position child */
