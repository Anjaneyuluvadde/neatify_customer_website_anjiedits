  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  padding: 20px;
  overscroll-behavior: contain;
}

.modal-container {
  background: #fff;
  width: 100%;
  max-width: 420px;
  max-height: 85vh;
  border-radius: 20px;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 20px 24px 16px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  animation: modalInvite 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  border: none;
}

.modal-scroll-content {
  overflow-y: auto;
  flex: 1;
  padding: 0 8px 0 0;
  -webkit-overflow-scrolling: touch;
  position: relative;
}

/* ========== MODAL HEADER (Add Ons title + inline close) ========== */
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid #f1f1f1;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.modal-heading {
  font-size: 18px;
  font-weight: 800;
  color: #111827;
  margin: 0;
  letter-spacing: -0.3px;
}

.modal-close-inline {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s ease;
}

.modal-close-inline::before {
  content: "✕";
  font-size: 13px;
  font-weight: 900;
  color: #fff;
}

.modal-close-inline:hover {
  background: rgba(0, 0, 0, 0.6);
}

.modal-footer {
  padding: 12px 0 0;
  border-top: 1px solid #f1f1f1;
  background: #fff;
  margin-top: 8px;
}

.modal-continue-btn {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #f4c430 0%, #fcd34d 100%);
  color: #000;
  border: none !important;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 900;
  cursor: pointer;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 10px 25px -5px rgba(244, 196, 48, 0.4);
  position: relative;
  overflow: hidden;
}

/* Shine for Continue Button */
.modal-continue-btn::after {
  content: "";
  position: absolute;
  top: -50%;
  left: -100%;
  width: 30%;
  height: 200%;
  background: rgba(255, 255, 255, 0.5);
  transform: rotate(30deg);
  animation: buttonShine 4s infinite;
}

.modal-continue-btn:hover {
  background: linear-gradient(135deg, #f4c430 0%, #fde047 100%);
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 20px 30px -10px rgba(244, 196, 48, 0.5);
}

.modal-continue-btn:active {
  transform: translateY(-1px) scale(0.98);
}

@keyframes modalInvite {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  border: none;
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  transition: background 0.25s ease, transform 0.2s ease;
}

.modal-close::before {
  content: "✕";
  font-size: 14px;
  font-weight: 900;
  color: #fff;
}

.modal-close:hover {
  background: rgba(0, 0, 0, 0.6);
}

.modal-title {
  font-size: 26px;
  font-weight: 900;
  color: #111827;
  letter-spacing: -1px;
  margin-bottom: 32px;
  text-align: left;
}

/* ADD-ON LIST ITEMS */
.addon-list-wrapper {
