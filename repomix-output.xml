                              <button
                                className="add-service-btn-small"
                                onClick={(e) => {
                                  e.stopPropagation();
                                  addService(svc);
                                }}
                              >
                                + Add
                              </button>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
