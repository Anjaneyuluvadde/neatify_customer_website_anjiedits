  border-color: #f4c430;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
}

.tile-icon-bg {
  width: 32px;
  height: 32px;
  background: #f8fafc;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
